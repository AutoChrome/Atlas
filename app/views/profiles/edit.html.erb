<% content_for :title, "Your profile" %>

<div class="stack" style="max-width: 480px;">
  <h1>Your profile</h1>

  <%= form_with model: @user, url: profile_path, method: :patch, class: "stack" do |f| %>
    <% if @user.errors.any? %>
      <div class="card card--outlined" style="border-color: var(--color-error);">
        <ul>
          <% @user.errors.each do |error| %>
            <li class="field__error"><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :name, class: "field__label" %>
      <%= f.text_field :name, class: "input", required: true %>
    </div>

    <div class="field">
      <%= f.label :email_address, "Email address", class: "field__label" %>
      <%= text_field_tag nil, @user.email_address, class: "input", disabled: true %>
      <p class="field__hint">Contact an admin to change your email address.</p>
    </div>

    <div class="field">
      <%= f.label :password, "New password", class: "field__label" %>
      <%= f.password_field :password, class: "input", autocomplete: "new-password", placeholder: "Leave blank to keep your current password" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "Confirm new password", class: "field__label" %>
      <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
    </div>

    <%= f.submit "Save changes", class: "btn btn--filled" %>
  <% end %>
</div>
