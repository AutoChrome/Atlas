<% if real_current_user&.admin? %>
  <% if guest_preview? %>
    <%= button_to guest_preview_path, method: :delete, class: "btn btn--icon is-active",
          title: "Exit guest preview", form: { style: "display: contents;" } do %>
      <%= fa_icon "eye-slash" %>
    <% end %>
  <% else %>
    <%= button_to guest_preview_path, method: :post, class: "btn btn--icon",
          title: "Preview as a guest visitor", form: { style: "display: contents;" } do %>
      <%= fa_icon "eye" %>
    <% end %>
  <% end %>
<% end %>
