<div class="nav-tree" data-controller="nav-reorder nav-drilldown"
     data-nav-drilldown-current-value="<%= current_drilldown_area_id || "root" %>">
  <div class="nav-tree__header">
    <span class="nav-tree__section-label">Areas</span>

    <div class="cluster" style="gap: 4px;">
      <div class="nav-tree__sort">
        <%= link_to "Sequence", url_for(request.query_parameters.merge(area_sort: "sequence")),
              class: class_names("nav-tree__sort-option", "is-active" => area_sort_mode == "sequence"),
              title: "Sort areas by an order you drag yourself" %>
        <%= link_to "A–Z", url_for(request.query_parameters.merge(area_sort: "alphabetical")),
              class: class_names("nav-tree__sort-option", "is-active" => area_sort_mode == "alphabetical"),
              title: "Sort areas alphabetically" %>
      </div>

      <button type="button" class="btn btn--icon btn--sm" data-nav-reorder-target="toggleButton"
              data-action="nav-reorder#toggle" aria-pressed="false"
              title="Drag areas into your own order — saved on this browser only">
        <%= fa_icon "arrows-up-down" %>
      </button>
    </div>
  </div>

  <%= render "shared/area_nav_level", area: nil, pages: [], charts: [], tutorials: [],
        areas: policy_scope(Area).top_level.ordered_by(area_sort_mode) %>

  <% if current_user&.admin? || current_user&.member? %>
    <%= link_to new_area_path, class: "nav-tree__link" do %>
      <%= icon :add, css_class: "nav-tree__icon" %>
      New area
    <% end %>
  <% end %>
</div>
