<% content_for :title, @announcement.title %>

<div class="stack container">
  <p class="text-muted"><%= link_to "← Back to announcements", announcements_path %></p>

  <div class="cluster" style="justify-content: space-between;">
    <div>
      <h1><%= @announcement.title %></h1>
      <% if @announcement.published? %>
        <span class="badge badge--success">Published <%= time_ago_in_words(@announcement.published_at) %> ago</span>
      <% else %>
        <span class="badge badge--warning">Draft — not yet sent to any platform</span>
      <% end %>
      <p class="text-muted mt-1">
        <% if @announcement.starts_on == @announcement.ends_on %>
          Runs all day on <%= @announcement.starts_on&.strftime("%B %-d, %Y") %>
        <% else %>
          Runs <%= @announcement.starts_on&.strftime("%B %-d, %Y") %> – <%= @announcement.ends_on&.strftime("%B %-d, %Y") %>
        <% end %>
      </p>
    </div>

    <div class="cluster">
      <% if policy(@announcement).update? %>
        <%= link_to "Edit", edit_announcement_path(@announcement), class: "btn btn--outlined" %>
      <% end %>
      <% if policy(@announcement).destroy? %>
        <%= button_to "Delete", announcement_path(@announcement), method: :delete,
              data: { turbo_confirm: "Delete this announcement?" }, class: "btn btn--danger" %>
      <% end %>
    </div>
  </div>

  <div class="trix-content">
    <%= @announcement.content %>
  </div>

  <p class="text-muted">
    Created <%= time_ago_in_words(@announcement.created_at) %> ago<%= " by #{@announcement.user.name}" if @announcement.user %>.
  </p>

  <% if policy(@announcement).publish? %>
    <section class="card card--outlined stack" style="max-width: 480px;">
      <h2><%= @announcement.published? ? "Re-send to platforms" : "Publish" %></h2>

      <%= form_with url: publish_announcement_path(@announcement), method: :post, class: "stack" do %>
        <% if @webhooks.any? %>
          <div class="field">
            <span class="field__label">Send to</span>
            <div class="stack" style="gap: 8px;">
              <% @webhooks.each do |webhook| %>
                <div class="checkbox">
                  <%= check_box_tag "webhook_ids[]", webhook.id, true, id: "webhook_#{webhook.id}" %>
                  <%= label_tag "webhook_#{webhook.id}", webhook.description %>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <p class="text-muted">
            No active platforms configured — this will mark the announcement as published, but nothing will be delivered anywhere.
          </p>
        <% end %>

        <%= submit_tag @announcement.published? ? "Re-send to platforms" : "Publish", class: "btn btn--gilt" %>
      <% end %>
    </section>
  <% end %>

  <% if @announcement.webhook_deliveries.any? %>
    <section class="stack">
      <h2>Delivery log</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>When</th>
            <th>Platform</th>
            <th>Result</th>
          </tr>
        </thead>
        <tbody>
          <% @announcement.webhook_deliveries.ordered.each do |delivery| %>
            <tr>
              <td><%= delivery.created_at.to_fs(:long) %></td>
              <td><%= delivery.webhook&.description || "(deleted platform)" %></td>
              <td>
                <% if delivery.success? %>
                  <span class="badge badge--success"><%= delivery.status_code %> OK</span>
                <% else %>
                  <span class="badge badge--error"><%= delivery.status_code || "Failed" %></span>
                  <% if delivery.error_message.present? %>
                    <span class="text-muted"><%= delivery.error_message %></span>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
</div>
