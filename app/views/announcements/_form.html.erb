<%= form_with model: announcement, class: "stack" do |f| %>
  <% if announcement.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <p class="field__error"><%= pluralize(announcement.errors.count, "error") %> prevented this announcement from being saved:</p>
      <ul>
        <% announcement.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, class: "field__label" %>
    <%= f.text_field :title, class: "input", required: true, spellcheck: true %>
  </div>

  <%= render "shared/rich_text_field", f: f %>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", announcement.persisted? ? announcement : announcements_path, class: "btn btn--text" %>
  </div>
<% end %>
