<%= form_with model: announcement, class: "stack" do |f| %>
  <% if announcement.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <p class="field__error"><%= pluralize(announcement.errors.count, "error") %> prevented this announcement from being saved:</p>
      <ul>
        <% announcement.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, class: "field__label" %>
    <%= f.text_field :title, class: "input", required: true, spellcheck: true %>
  </div>

  <div data-controller="date-range">
    <div class="cluster" style="align-items: flex-start;">
      <div class="field" style="flex: 1;">
        <%= f.label :starts_on, "Starts on", class: "field__label" %>
        <%= f.date_field :starts_on, class: "input", required: true,
              data: { date_range_target: "start", action: "click->date-range#openPicker change->date-range#syncMin" } %>
      </div>
      <div class="field" style="flex: 1;">
        <%= f.label :ends_on, "Ends on", class: "field__label" %>
        <%= f.date_field :ends_on, class: "input", required: true,
              data: { date_range_target: "end", action: "click->date-range#openPicker" } %>
      </div>
    </div>
    <p class="field__hint">Announcements run a whole day at minimum — the end date can be the same as the start date.</p>
  </div>

  <%= render "shared/rich_text_field", f: f %>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", announcement.persisted? ? announcement : announcements_path, class: "btn btn--text" %>
  </div>
<% end %>
