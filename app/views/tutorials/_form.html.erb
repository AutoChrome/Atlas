<%= form_with model: [area, tutorial], class: "stack" do |f| %>
  <% if tutorial.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <p class="field__error"><%= pluralize(tutorial.errors.count, "error") %> prevented this tutorial from being saved:</p>
      <ul>
        <% tutorial.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, class: "field__label" %>
    <%= f.text_field :title, class: "input", required: true, spellcheck: true %>
  </div>

  <div class="field">
    <%= f.label :description, "Overview description", class: "field__label" %>
    <%= f.rich_text_area :description, spellcheck: true %>
    <p class="field__hint">Shown on the tutorial's overview screen, above the list of steps.</p>
  </div>

  <%= render "shared/icon_field", f: f %>

  <div class="checkbox">
    <%= f.check_box :public %>
    <%= f.label :public, "Public — visible without signing in" %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", tutorial.persisted? ? [area, tutorial] : area, class: "btn btn--text" %>
  </div>
<% end %>
