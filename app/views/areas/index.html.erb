<% content_for :title, "Atlas" %>

<div class="stack">
  <div class="cluster" style="justify-content: space-between;">
    <h1>Atlas</h1>
    <% if policy(Area).create? %>
      <%= link_to "New area", new_area_path, class: "btn btn--filled" %>
    <% end %>
  </div>

  <% if @latest_announcement %>
    <%= link_to @latest_announcement, class: "card card--interactive" do %>
      <div class="cluster" style="justify-content: space-between;">
        <div class="cluster">
          <%= fa_icon "bullhorn" %>
          <span class="card__title"><%= @latest_announcement.title %></span>
        </div>
        <span class="text-muted"><%= time_ago_in_words(@latest_announcement.published_at) %> ago</span>
      </div>

      <% if current_user&.admin? %>
        <div class="cluster mt-3">
          <% deliveries = @latest_announcement.latest_deliveries %>
          <% if deliveries.any? %>
            <% deliveries.each do |delivery| %>
              <span class="badge <%= delivery.success? ? "badge--success" : "badge--error" %>">
                <%= delivery.webhook&.description || "(deleted platform)" %>
              </span>
            <% end %>
          <% else %>
            <span class="text-muted">Not sent to any platform yet.</span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if @areas.any? %>
    <div class="card-grid">
      <% @areas.each do |area| %>
        <%= link_to area, class: "card card--interactive" do %>
          <div class="cluster" style="justify-content: space-between;">
            <div class="card__title cluster"><%= record_icon(area, fallback: :folder) %> <%= area.name %></div>
            <% if current_user && area.public? %>
              <span class="badge badge--success">Public</span>
            <% end %>
          </div>
          <p class="card__meta"><%= truncate(area.description, length: 140) if area.description.present? %></p>
          <p class="card__meta mt-3"><%= pluralize(area.pages.count, "page") %></p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">No areas yet<%= ". Create the first one to get started." if policy(Area).create? %></p>
  <% end %>
</div>
