<%= form_with model: area, class: "stack", style: "max-width: 560px;" do |f| %>
  <% if area.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <p class="field__error"><%= pluralize(area.errors.count, "error") %> prevented this area from being saved:</p>
      <ul>
        <% area.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, class: "field__label" %>
    <%= f.text_field :name, class: "input", required: true, spellcheck: true %>
  </div>

  <div class="field">
    <%= f.label :description, class: "field__label" %>
    <%= f.text_area :description, class: "textarea", rows: 4, spellcheck: true %>
  </div>

  <%= render "shared/icon_field", f: f %>

  <div class="field">
    <%= f.label :parent_id, "Parent area", class: "field__label" %>
    <%# Sorted by the full "Parent > Child" path (not just each area's own
        name) so areas under the same parent cluster together, and so two
        areas that happen to share a name are told apart by where they
        actually live instead of showing up as identical-looking options. %>
    <%= f.collection_select :parent_id, Area.where.not(id: area.id).sort_by(&:path_name), :id, :path_name,
          { include_blank: "None — top level" }, class: "select" %>
  </div>

  <div class="checkbox">
    <%= f.check_box :public %>
    <%= f.label :public, "Public — visible without signing in" %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", area.persisted? ? area : areas_path, class: "btn btn--text" %>
  </div>
<% end %>
