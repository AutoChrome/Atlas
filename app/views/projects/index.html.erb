<% content_for :title, "Projects" %>

<div class="stack">
  <div class="cluster" style="justify-content: space-between;">
    <h1>Projects</h1>
    <% if policy(Project).create? %>
      <%= link_to "New project", new_project_path, class: "btn btn--filled" %>
    <% end %>
  </div>

  <% if @projects.any? %>
    <div class="card-grid">
      <% @projects.each do |project| %>
        <%= link_to project, class: "card card--interactive" do %>
          <div class="card__title cluster"><%= fa_icon "map" %> <%= project.name %></div>
          <p class="card__meta"><%= truncate(project.description, length: 140) if project.description.present? %></p>
          <p class="card__meta mt-3"><%= pluralize(project.roadmap_sections.count, "section") %></p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">No projects yet<%= ". Create the first one to get started." if policy(Project).create? %></p>
  <% end %>
</div>
