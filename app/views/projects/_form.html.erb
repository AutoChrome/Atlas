<%= form_with model: project, class: "stack", style: "max-width: 560px;" do |f| %>
  <% if project.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <p class="field__error"><%= pluralize(project.errors.count, "error") %> prevented this project from being saved:</p>
      <ul>
        <% project.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, class: "field__label" %>
    <%= f.text_field :name, class: "input", required: true, spellcheck: true %>
  </div>

  <div class="field">
    <%= f.label :description, class: "field__label" %>
    <%= f.text_area :description, class: "textarea", rows: 4, spellcheck: true %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", project.persisted? ? project : projects_path, class: "btn btn--text" %>
  </div>
<% end %>
