<% content_for :title, "Reset your password" %>

<%= form_with url: password_path(params[:token]), method: :put, class: "stack" do |form| %>
  <div class="field">
    <%= form.label :password, "New password", class: "field__label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "Repeat new password", class: "field__label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
  </div>

  <%= form.submit "Save", class: "btn btn--filled" %>
<% end %>
