<%= form_with model: user, url: user.persisted? ? admin_user_path(user) : admin_users_path, class: "stack", style: "max-width: 480px;" do |f| %>
  <% if user.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <ul>
        <% user.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, class: "field__label" %>
    <%= f.text_field :name, class: "input", required: true %>
  </div>

  <div class="field">
    <%= f.label :email_address, "Email address", class: "field__label" %>
    <%= f.email_field :email_address, class: "input", required: true %>
  </div>

  <div class="field">
    <%= f.label :role, class: "field__label" %>
    <%= f.select :role, User.roles.keys.map { |r| [r.capitalize, r] }, {}, class: "select" %>
  </div>

  <% unless user.persisted? %>
    <p class="field__hint">
      No password to set here — <%= user.name.presence || "the new user" %> will get an email
      with a link to choose their own password.
    </p>
  <% end %>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", admin_users_path, class: "btn btn--text" %>
  </div>
<% end %>
