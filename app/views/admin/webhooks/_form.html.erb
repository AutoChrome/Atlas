<%= form_with model: webhook, url: webhook.persisted? ? admin_webhook_path(webhook) : admin_webhooks_path, class: "stack", style: "max-width: 560px;" do |f| %>
  <% if webhook.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <ul>
        <% webhook.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :description, class: "field__label" %>
    <%= f.text_field :description, class: "input", placeholder: "e.g. Intranet home page banner", required: true %>
  </div>

  <div class="field">
    <%= f.label :url, "URL to POST to", class: "field__label" %>
    <%= f.url_field :url, class: "input", placeholder: "https://example.com/webhooks/atlas", required: true %>
    <p class="field__hint">Every published announcement is sent here as JSON. See the <%= link_to "integration guide", docs_admin_webhooks_path %> for the exact payload.</p>
  </div>

  <div class="field">
    <%= f.label :content_format, "Content format", class: "field__label" %>
    <%= f.select :content_format,
          options_for_select(
            [ [ "Safe HTML — full formatting, attachments included", "html" ],
              [ "Raw text — formatting and attachments stripped to plain text", "plain_text" ] ],
            f.object.content_format
          ), {}, class: "input" %>
    <p class="field__hint">
      What the announcement's <code class="font-mono">content</code> field looks like in the payload
      this webhook receives. See the <%= link_to "integration guide", docs_admin_webhooks_path %>
      for exactly what each produces.
    </p>
  </div>

  <div class="field" data-controller="key-value-editor">
    <div class="cluster" style="justify-content: space-between;">
      <%= f.label :custom_parameters_json, "Custom parameters", class: "field__label" %>
      <div class="cluster" style="gap: 4px;">
        <button type="button" class="btn btn--text btn--sm" data-key-value-editor-target="pairsTab" data-action="key-value-editor#showPairs">Key/value pairs</button>
        <button type="button" class="btn btn--text btn--sm" data-key-value-editor-target="jsonTab" data-action="key-value-editor#showJson">Raw JSON</button>
      </div>
    </div>

    <div data-key-value-editor-target="pairsView" class="stack" style="gap: 8px;">
      <div data-key-value-editor-target="list" class="stack" style="gap: 8px;"></div>
      <button type="button" class="btn btn--text btn--sm" data-action="key-value-editor#addRow">
        <%= fa_icon "plus" %> Add parameter
      </button>
    </div>

    <template data-key-value-editor-target="template">
      <div class="cluster" data-key-value-editor-target="row" style="gap: 8px; flex-wrap: nowrap;">
        <input type="text" class="input" placeholder="Key" data-key-value-editor-target="key" data-action="input->key-value-editor#syncFromPairs">
        <input type="text" class="input" placeholder="Value" data-key-value-editor-target="value" data-action="input->key-value-editor#syncFromPairs">
        <button type="button" class="btn btn--icon btn--sm" data-action="key-value-editor#removeRow" aria-label="Remove parameter">
          <%= fa_icon "trash" %>
        </button>
      </div>
    </template>

    <%= f.text_area :custom_parameters_json, class: "input font-mono", rows: 6,
          data: { key_value_editor_target: "textarea" },
          placeholder: "{\n  \"team\": \"platform\",\n  \"environment\": \"production\"\n}" %>
    <p class="field__error" data-key-value-editor-target="jsonError" hidden>
      That's not a flat JSON object — fix it here, or switch back once it is.
    </p>

    <p class="field__hint">
      Optional. String, number, boolean, or <code class="font-mono">null</code> values only, no nested
      objects or arrays — sent as-is under <code class="font-mono">custom_parameters</code> in every
      payload this webhook receives. Leave empty to send none. The key/value view only ever produces
      string values; switch to raw JSON for a number, boolean, or <code class="font-mono">null</code>.
    </p>
  </div>

  <div class="checkbox">
    <%= f.check_box :active %>
    <%= f.label :active, "Active — deliver announcements to this webhook" %>
  </div>

  <% unless webhook.persisted? %>
    <p class="field__hint">A signing secret is generated automatically — you'll be able to view it once this webhook is created.</p>
  <% end %>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", admin_webhooks_path, class: "btn btn--text" %>
  </div>
<% end %>
