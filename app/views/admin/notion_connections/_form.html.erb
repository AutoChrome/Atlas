<%= form_with model: [ :admin, notion_connection ], class: "stack", style: "max-width: 560px;" do |f| %>
  <% if notion_connection.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <ul>
        <% notion_connection.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, class: "field__label" %>
    <%= f.text_field :name, class: "input", placeholder: "e.g. Atlas First B2B", required: true %>
    <p class="field__hint">Match this to the connection's name in Notion — makes it obvious which is which later.</p>
  </div>

  <div class="field">
    <%= f.label :integration_token, "Integration token", class: "field__label" %>
    <%= f.password_field :integration_token, class: "input font-mono", autocomplete: "off",
          placeholder: notion_connection.persisted? ? "Leave blank to keep the current token" : "secret_...",
          required: !notion_connection.persisted? %>
    <p class="field__hint">
      From Notion's connection page — <strong>Configuration → Integration token → Access token</strong>. Never
      pre-filled here once saved, so leaving this blank on an edit keeps the existing one.
    </p>
  </div>

  <div class="field">
    <%= f.label :area_id, "Area", class: "field__label" %>
    <%= f.collection_select :area_id, Area.all.sort_by(&:path_name), :id, :path_name, { prompt: "Select an area" }, { class: "input", required: true } %>
    <p class="field__hint">Where synced pages land — every page this connection creates or updates goes here.</p>
  </div>

  <div class="field">
    <%= f.label :notion_workspace_name, "Notion workspace (optional)", class: "field__label" %>
    <%= f.text_field :notion_workspace_name, class: "input", placeholder: "e.g. IAN's Notion" %>
    <p class="field__hint">Purely a label for your own reference — shown on the connections list, nothing else reads it.</p>
  </div>

  <div class="checkbox">
    <%= f.check_box :active %>
    <%= f.label :active, "Active — accept and sync incoming pages from Notion" %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", admin_notion_connections_path, class: "btn btn--text" %>
  </div>
<% end %>
