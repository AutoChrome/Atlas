<%= form_with model: [area, tutorial, tutorial_step], class: "stack" do |f| %>
  <% if tutorial_step.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <p class="field__error"><%= pluralize(tutorial_step.errors.count, "error") %> prevented this step from being saved:</p>
      <ul>
        <% tutorial_step.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, class: "field__label" %>
    <%= f.text_field :title, class: "input", required: true, spellcheck: true %>
  </div>

  <%= render "shared/rich_text_field", f: f %>

  <div class="field">
    <%= f.label :attachments, "Add attachments", class: "field__label" %>
    <%= f.file_field :attachments, multiple: true %>
    <p class="field__hint">Images, videos, PDFs — anything you want available alongside this step.</p>
  </div>

  <section class="stack" data-controller="nested-fields">
    <h2>Tasks</h2>
    <p class="text-muted">
      One task means viewers just check this whole step off as done. Add more to turn it into a checklist. Leave
      "If ticked/crossed" alone for a plain linear tutorial — it continues to the next step automatically either way.
      Set one to send viewers to a different step depending on how they answer.
    </p>

    <div class="stack" style="gap: 8px;" data-nested-fields-target="list">
      <%= f.fields_for :tutorial_tasks do |task_form| %>
        <%= render "task_fields", f: task_form, tutorial: tutorial, tutorial_step: tutorial_step %>
      <% end %>
    </div>

    <template data-nested-fields-target="template">
      <%= f.fields_for :tutorial_tasks, TutorialTask.new, child_index: "NEW_RECORD" do |task_form| %>
        <%= render "task_fields", f: task_form, tutorial: tutorial, tutorial_step: tutorial_step %>
      <% end %>
    </template>

    <div>
      <button type="button" class="btn btn--outlined btn--sm" data-action="click->nested-fields#add">
        <%= fa_icon "plus" %> Add task
      </button>
    </div>
  </section>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", [ area, tutorial ], class: "btn btn--text" %>
  </div>
<% end %>
