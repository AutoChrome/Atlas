<%# locals: area:, chart:, table:, can_edit:, relationships: (the chart's full, preloaded relationship set — filtered here to just the ones touching this table) %>
<% table_relationships = relationships.select { |rel| rel.from_chart_table.id == table.id || rel.to_chart_table.id == table.id } %>
<% related_table_ids = table_relationships.flat_map { |rel| [ rel.from_chart_table.id, rel.to_chart_table.id ] }.uniq - [ table.id ] %>
<% search_text = ([ table.name ] + table.chart_columns.map(&:name)).join(" ").downcase %>
<div class="chart-table" data-chart-table-id="<%= table.id %>" data-chart-search-target="table"
     data-search-text="<%= search_text %>" data-related-table-ids="<%= related_table_ids.join(",") %>">
  <div class="chart-table__header">
    <div class="chart-table__header-top">
      <%= fa_icon "table", css_class: "chart-table__icon" %>

      <% if can_edit %>
        <div class="cluster" style="gap: 2px;">
          <div data-controller="modal" data-modal-src-value="<%= new_area_chart_chart_column_path(area, chart, chart_table_id: table.id) %>">
            <button type="button" class="btn btn--icon btn--sm" data-action="click->modal#open" aria-label="Add column">
              <%= fa_icon "plus" %>
            </button>
            <dialog class="modal" data-modal-target="dialog" data-action="click->modal#closeOnBackdrop"></dialog>
          </div>

          <%= button_to area_chart_chart_table_path(area, chart, table), method: :delete,
                data: { turbo_confirm: "Delete table \"#{table.name}\" and all its columns?" },
                class: "btn btn--icon btn--sm", form: { class: "kanban-column__delete-form" }, aria: { label: "Delete table" } do %>
            <%= fa_icon "trash" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# safe_join + <wbr> so a long name wraps at its underscores first —
        overflow-wrap: anywhere (see _chart_canvas.scss) is just the
        fallback for the rare name with no underscore to break on at all. %>
    <span class="chart-table__name"><%= safe_join(table.name.split("_"), "_".html_safe + tag.wbr) %></span>
  </div>

  <div class="chart-table__columns">
    <% table.chart_columns.each do |column| %>
      <%= render "chart_columns/column", area: area, chart: chart, table: table, column: column, can_edit: can_edit %>
    <% end %>
  </div>

  <% if table.chart_indices.any? || table.notes.present? %>
    <div class="chart-table__footer">
      <% table.chart_indices.each do |index| %>
        <div class="chart-table__index text-muted cluster" style="justify-content: space-between;">
          <span><%= fa_icon "list" %> <%= safe_join(index.name.split("_"), "_".html_safe + tag.wbr) %> (<%= index.columns %>)<%= " · UNIQUE" if index.unique? %></span>
          <% if can_edit %>
            <%= button_to area_chart_chart_index_path(area, chart, index), method: :delete,
                  data: { turbo_confirm: "Delete index \"#{index.name}\"?" }, class: "btn btn--icon btn--sm",
                  form: { class: "kanban-column__delete-form" }, aria: { label: "Delete index" } do %>
              <%= fa_icon "trash" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <% if table.notes.present? %>
        <p class="chart-table__notes text-muted"><%= table.notes %></p>
      <% end %>
    </div>
  <% end %>

  <% if can_edit %>
    <div data-controller="modal" data-modal-src-value="<%= new_area_chart_chart_index_path(area, chart, chart_table_id: table.id) %>">
      <button type="button" class="btn btn--text btn--sm" data-action="click->modal#open">
        <%= fa_icon "plus" %> Add index
      </button>
      <dialog class="modal" data-modal-target="dialog" data-action="click->modal#closeOnBackdrop"></dialog>
    </div>
  <% end %>

  <% if table_relationships.any? %>
    <details class="chart-table__relationships">
      <summary>Relationships (<%= table_relationships.size %>)</summary>
      <ul class="chart-table__relationships-list">
        <% table_relationships.each do |rel| %>
          <li>
            <% if rel.from_chart_table.id == table.id %>
              <strong><%= rel.from_chart_column.name %></strong>
              <%= fa_icon "arrow-right" %>
              <%= rel.to_chart_table.name %>.<strong><%= rel.to_chart_column.name %></strong>
            <% else %>
              <strong><%= rel.to_chart_column.name %></strong>
              <%= fa_icon "arrow-left" %>
              <%= rel.from_chart_table.name %>.<strong><%= rel.from_chart_column.name %></strong>
            <% end %>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>
