<%# locals: area:, chart:, table:, column:, can_edit: %>
<div class="chart-column">
  <div class="chart-column__row">
    <span class="chart-column__name"><%= safe_join(column.name.split("_"), "_".html_safe + tag.wbr) %></span>
    <% if column.data_type.present? %>
      <span class="chart-column__type text-muted"><%= column.data_type %></span>
    <% end %>

    <span class="chart-column__badges">
      <% if column.primary_key? %>
        <span class="chart-badge chart-badge--pk" title="Primary key"><%= fa_icon "key" %> PK</span>
      <% end %>
      <% if column.foreign_key? %>
        <span class="chart-badge chart-badge--fk" title="Foreign key">FK</span>
      <% end %>
      <% if column.unique? %>
        <span class="chart-badge chart-badge--unique" title="Unique constraint">UNIQUE</span>
      <% end %>
      <% if column.indexed? %>
        <span class="badge" title="Indexed"><%= fa_icon "bolt" %></span>
      <% end %>
      <% unless column.nullable? %>
        <span class="chart-column__not-null text-muted">NOT NULL</span>
      <% end %>
    </span>

    <% if can_edit %>
      <div class="cluster" style="gap: 2px;" data-controller="modal"
           data-modal-src-value="<%= edit_area_chart_chart_column_path(area, chart, column) %>">
        <button type="button" class="btn btn--icon btn--sm" data-action="click->modal#open" aria-label="Edit column">
          <%= fa_icon "pen" %>
        </button>
        <dialog class="modal" data-modal-target="dialog" data-action="click->modal#closeOnBackdrop"></dialog>
      </div>
    <% end %>
  </div>

  <% column_relationships = column.outgoing_relationships + column.incoming_relationships %>
  <% if column_relationships.any? %>
    <details class="chart-column__relationships">
      <summary>Referenced (<%= column_relationships.size %>)</summary>
      <ul class="chart-column__relationships-list">
        <% column.outgoing_relationships.each do |rel| %>
          <li><%= fa_icon "arrow-right" %> <%= rel.to_chart_column.chart_table.name %>.<%= rel.to_chart_column.name %></li>
        <% end %>
        <% column.incoming_relationships.each do |rel| %>
          <li><%= fa_icon "arrow-left" %> <%= rel.from_chart_column.chart_table.name %>.<%= rel.from_chart_column.name %></li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>
