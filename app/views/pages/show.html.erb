<% content_for :title, @page.title %>

<div class="stack container">
  <%= render "shared/breadcrumbs", area: @area, page: @page %>

  <div class="cluster" style="justify-content: space-between;">
    <div>
      <h1 class="cluster"><%= record_icon(@page, fallback: :page) %> <%= @page.title %></h1>
      <% if current_user && @page.public? %>
        <span class="badge badge--success">Public — visible without signing in</span>
      <% end %>
      <%# Refreshes on page load/reload, not pushed live — a sync is
          typically a few seconds of work, so this is mainly useful for
          confirming a recent edit in Notion actually arrived, not for
          watching it happen in real time. %>
      <% if current_user && (sync = @page.current_notion_sync) %>
        <% if sync.syncing? %>
          <span class="badge badge--warning" title="A change in Notion is being pulled in right now">⏳ Syncing from Notion…</span>
        <% elsif sync.succeeded? %>
          <span class="badge badge--success" title="<%= sync.completed_at.to_fs(:long) %>">Synced from Notion <%= time_ago_in_words(sync.completed_at) %> ago</span>
        <% elsif sync.failed? %>
          <span class="badge badge--error" title="<%= sync.error_message %>">⚠ Last Notion sync failed</span>
        <% end %>
      <% end %>
    </div>

    <div class="cluster">
      <%= render "shared/share_button", url: area_page_url(@area, @page) %>

      <% if current_user %>
        <% if policy(@page).update? %>
          <%= link_to "Edit", edit_area_page_path(@area, @page), class: "btn btn--outlined" %>
        <% end %>
        <% if policy(@page).destroy? %>
          <%= button_to "Delete", area_page_path(@area, @page), method: :delete,
                data: { turbo_confirm: "Delete this page?" }, class: "btn btn--danger" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="trix-content">
    <%= @page.content %>
  </div>

  <% if @page.page_attachments.any? %>
    <section class="stack">
      <h2>Attachments</h2>
      <div class="stack">
        <% @page.page_attachments.each do |page_attachment| %>
          <% next unless page_attachment.file.attached? %>
          <div class="card cluster" style="justify-content: space-between;">
            <span class="cluster" style="gap: 6px;">
              <%= fa_icon "paperclip" %>
              <span>
                <%= page_attachment.label.presence || page_attachment.effective_filename %>
                <% if page_attachment.label.present? %>
                  <span class="text-muted">— <%= page_attachment.effective_filename %></span>
                <% end %>
              </span>
            </span>
            <%= link_to "Download",
                  download_area_page_page_attachment_path(@area, @page, page_attachment),
                  class: "btn btn--text btn--sm" %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <p class="text-muted">
    Last updated <%= time_ago_in_words(@page.updated_at) %> ago<%= " by #{@page.user.name}" if @page.user %>.
  </p>
</div>
