<%= form_with model: [area, page], class: "stack" do |f| %>
  <% if page.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <p class="field__error"><%= pluralize(page.errors.count, "error") %> prevented this page from being saved:</p>
      <ul>
        <% page.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, class: "field__label" %>
    <%= f.text_field :title, class: "input", required: true, spellcheck: true %>
  </div>

  <div class="field" data-controller="page-reference" data-page-reference-search-url-value="<%= search_path %>">
    <%= f.label :content, class: "field__label" %>
    <%= f.rich_text_area :content, spellcheck: true, data: { page_reference_target: "editor" } %>

    <dialog class="modal" data-page-reference-target="dialog" data-action="click->page-reference#closeOnBackdrop">
      <div class="modal__header">
        <h3>Link to a page or area</h3>
        <button type="button" class="btn btn--icon btn--sm" data-action="page-reference#close" aria-label="Close">
          <%= icon :close %>
        </button>
      </div>
      <div class="modal__body stack">
        <input type="search" class="input" placeholder="Search for a page or area…" autocomplete="off"
               data-page-reference-target="input" data-action="input->page-reference#search">
        <div class="stack" data-page-reference-target="results" style="max-height: 320px; overflow-y: auto;"></div>
      </div>
    </dialog>
  </div>

  <%= render "shared/icon_field", f: f %>

  <div class="field">
    <%= f.label :attachments, "Add attachments", class: "field__label" %>
    <%= f.file_field :attachments, multiple: true %>
    <p class="field__hint">Images, videos, PDFs — anything you want available for download alongside the page.</p>
  </div>

  <div class="checkbox">
    <%= f.check_box :public %>
    <%= f.label :public, "Public — visible without signing in" %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", page.persisted? ? [area, page] : area, class: "btn btn--text" %>
  </div>
<% end %>
