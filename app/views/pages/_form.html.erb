<%= form_with model: [area, page], class: "stack" do |f| %>
  <% if page.errors.any? %>
    <div class="card card--outlined" style="border-color: var(--color-error);">
      <p class="field__error"><%= pluralize(page.errors.count, "error") %> prevented this page from being saved:</p>
      <ul>
        <% page.errors.each do |error| %>
          <li class="field__error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, class: "field__label" %>
    <%= f.text_field :title, class: "input", required: true, spellcheck: true %>
  </div>

  <%# Only for an existing page — for a brand new one, the area is already
      fixed by whichever area's "New page" button got you to this form, so
      a picker here would just be a redundant second way to set the same
      thing. %>
  <% if page.persisted? %>
    <div class="field">
      <%= f.label :area_id, "Area", class: "field__label" %>
      <%= f.collection_select :area_id, Area.all.sort_by(&:path_name), :id, :path_name, {}, { class: "input" } %>
      <p class="field__hint">
        Moves this page to a different area on save. If a page with the same title already exists there,
        this one's URL gets a randomized suffix to stay unique rather than failing to save — rename one of
        them afterward if you'd rather have a clean URL.
      </p>
    </div>
  <% end %>

  <%= render "shared/rich_text_field", f: f %>

  <%= render "shared/icon_field", f: f %>

  <div class="field" data-controller="attachment-fields"
       data-action="dragenter@window->attachment-fields#dragEnter dragover@window->attachment-fields#dragOver
                    dragleave@window->attachment-fields#dragLeave drop@window->attachment-fields#drop">
    <span class="field__label">Attachments</span>

    <div class="attachment-dropzone" data-action="click->attachment-fields#browse">
      <%= fa_icon "cloud-arrow-up" %>
      <p>Drag files anywhere on this page, or <strong>click to browse</strong></p>
    </div>
    <input type="file" multiple hidden data-attachment-fields-target="fileInput" data-action="change->attachment-fields#filesSelected">

    <div class="stack" style="gap: 8px; margin-top: 8px;" data-attachment-fields-target="list">
      <%= f.fields_for :page_attachments do |attachment_form| %>
        <%= render "attachment_fields", f: attachment_form %>
      <% end %>
    </div>

    <template data-attachment-fields-target="template">
      <%= f.fields_for :page_attachments, PageAttachment.new, child_index: "NEW_RECORD" do |attachment_form| %>
        <%= render "attachment_fields", f: attachment_form %>
      <% end %>
    </template>

    <div class="attachment-drop-overlay" data-attachment-fields-target="dropOverlay" hidden>
      <div class="attachment-drop-overlay__message">
        <%= fa_icon "cloud-arrow-up" %>
        <p>Drop to attach</p>
      </div>
    </div>

    <p class="field__hint">
      Images, videos, PDFs — anything you want available for download alongside the page. Give one a label so
      people know what it is, or a different download name if the original filename isn't a good fit.
    </p>
  </div>

  <div class="checkbox">
    <%= f.check_box :public %>
    <%= f.label :public, "Public — visible without signing in" %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn--filled" %>
    <%= link_to "Cancel", page.persisted? ? [area, page] : area, class: "btn btn--text" %>
  </div>
<% end %>
