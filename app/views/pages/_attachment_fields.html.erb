<%# locals: f: (a fields_for builder for one PageAttachment) %>
<div class="attachment-field" data-attachment-fields-target="item">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy %>
  <%= f.file_field :file, hidden: true %>

  <div class="cluster" style="justify-content: space-between; align-items: flex-start;">
    <span class="cluster attachment-field__name" style="gap: 6px;">
      <%= fa_icon "paperclip" %>
      <span data-attachment-fields-target="previewName">
        <% if f.object.persisted? && f.object.file.attached? %>
          <%= link_to f.object.file.filename.to_s,
                download_area_page_page_attachment_path(f.object.page.area, f.object.page, f.object),
                class: "text-muted" %>
        <% else %>
          New file
        <% end %>
      </span>
    </span>
    <button type="button" class="btn btn--icon btn--sm" data-action="click->attachment-fields#remove" aria-label="Remove attachment">
      <%= fa_icon "trash" %>
    </button>
  </div>

  <div class="cluster" style="gap: 8px; align-items: flex-start;">
    <div class="field" style="flex: 1; margin-bottom: 0;">
      <%= f.label :label, class: "field__label" %>
      <%= f.text_field :label, class: "input", placeholder: "What is this file?" %>
    </div>
    <div class="field" style="flex: 1; margin-bottom: 0;">
      <%= f.label :download_filename, "Download as", class: "field__label" %>
      <%= f.text_field :download_filename, class: "input", data: { attachment_fields_target: "downloadFilenameInput" },
            placeholder: f.object.persisted? && f.object.file.attached? ? f.object.file.filename.to_s : "Original filename" %>
    </div>
  </div>
</div>
