# Copy this file to .env and fill in real values. .env is gitignored.

# --- Rails ---
# Generate with: bin/rails secret (or `openssl rand -hex 64`) — a fresh,
# random value, independent of any machine's config/master.key. Nothing in
# this app actually uses Rails encrypted credentials (config/master.key /
# credentials.yml.enc), so there's no need to set RAILS_MASTER_KEY too —
# Rails reads SECRET_KEY_BASE before ever falling back to credentials.
SECRET_KEY_BASE=
# Deliberately NOT set here: Dockerfile bakes RAILS_ENV=production and
# Dockerfile.dev bakes RAILS_ENV=development, and env_file only overrides a
# key that's actually present in .env — adding RAILS_ENV here (e.g. by
# copying a dev .env onto a production host) silently overrides the
# image's own correct value and boots the wrong environment entirely.
RAILS_LOG_TO_STDOUT=true

# --- Database (Postgres container) ---
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Caddy ---
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# --- File storage: "local" (default) or "amazon" ---
STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
AWS_S3_BUCKET=

# --- Active Record Encryption (webhook signing secrets) ---
# Generate with: docker compose run --rm web bin/rails db:encryption:init
# (or just three random strings — they only need to be long and secret).
# Changing these after webhooks exist makes their stored secrets unreadable.
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Basecamp webhook integration (see /admin/integrations/basecamp) ---
# Any long random string — generate with `SecureRandom.hex(32)`. Changing
# this invalidates whatever URL you've already pasted into Basecamp.
BASECAMP_WEBHOOK_TOKEN=

# --- Outgoing email (password resets, account setup) ---
# Leave SMTP_ADDRESS blank in development — mail is caught by letter_opener
# instead of actually sending. In production, leaving it blank just means
# those emails silently fail to send; nothing else in the app depends on it.
#
# For AWS SES's SMTP interface: SMTP_ADDRESS is region-specific
# (email-smtp.<region>.amazonaws.com — must match AWS_REGION above if
# that's the same AWS account); SMTP_USERNAME/SMTP_PASSWORD are SES's own
# generated SMTP credentials, NOT your IAM AWS_ACCESS_KEY_ID/SECRET above —
# generate them from the SES console (or `aws sesv2 create-email-identity`
# flow) under "SMTP settings", not from IAM directly. MAILER_FROM's domain
# must be a verified SES identity or every send gets rejected.
#
# SMTP_AUTHENTICATION: login (default), plain, or cram_md5 — SES supports
# login and plain.
# SMTP_USE_SSL: true for implicit TLS (typically port 465); leave unset/false
# for STARTTLS on port 587 (SES supports both).
MAILER_FROM=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_USE_SSL=false
