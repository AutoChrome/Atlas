# Copy this file to .env and fill in real values. .env is gitignored.

# --- Rails ---
RAILS_MASTER_KEY=            # contents of config/master.key
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true

# --- Database (Postgres container) ---
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Caddy ---
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# --- File storage: "local" (default) or "amazon" ---
STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
AWS_S3_BUCKET=

# --- Active Record Encryption (webhook signing secrets) ---
# Generate with: docker compose run --rm web bin/rails db:encryption:init
# (or just three random strings — they only need to be long and secret).
# Changing these after webhooks exist makes their stored secrets unreadable.
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
