# Local dev: https://localhost (Caddy auto-provisions a locally-trusted
# cert and redirects http -> https). In production, set SITE_ADDRESS to your
# real domain (e.g. docs.example.com) and Caddy will provision real TLS the
# same way.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	@assets path /assets/* /rails/active_storage/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The actual reverse_proxy target lives in upstream.caddy, not here —
	# see that file's own comment, and scripts/deploy.sh, for why: a zero-downtime
	# deploy needs to repoint this at a freshly-started container, health
	# check it, then cut over — all without restarting Caddy itself (which
	# would drop its listening socket for a moment). Editing *this* file
	# and reloading would work for that too, but keeping the one line that
	# actually changes in its own file makes the deploy script's job (and
	# a git diff of what a deploy actually touched) a lot smaller.
	import upstream.caddy
}

# Plain-HTTP alias for tooling that can't reach the "localhost" hostname
# directly (some sandboxed browser automation refuses it by name). Explicit
# http:// scheme keeps Caddy from trying to issue a cert or redirect here —
# this block is additive and doesn't change the https://localhost block above.
http://127.0.0.1 {
	import upstream.caddy
}
