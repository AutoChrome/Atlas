# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored

# bin/* scripts are invoked directly (via their #! shebang) inside Linux
# containers — a CRLF line ending breaks that (`env: 'ruby\r': No such file
# or directory`) even though the script still "looks" fine on Windows.
# Force LF regardless of platform or a contributor's core.autocrlf setting.
bin/* text eol=lf
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials
