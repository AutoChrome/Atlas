# syntax=docker/dockerfile:1
# Development image: used by docker-compose.yml. Not for production/Kamal — see Dockerfile for that.

ARG RUBY_VERSION=3.3.12
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# System packages needed to build native gems (pg, bcrypt, nokogiri) and process images (image_processing/libvips)
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      git \
      libpq-dev \
      libvips \
      libyaml-dev \
      pkg-config \
      curl \
      postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV BUNDLE_PATH="/usr/local/bundle" \
    RAILS_ENV="development"

COPY Gemfile Gemfile.lock ./
RUN bundle install && gem install foreman --no-document

COPY . .
RUN chmod +x bin/dev-entrypoint

EXPOSE 3000

ENTRYPOINT ["bin/dev-entrypoint"]
# Runs Procfile.dev via foreman: the Rails server AND a Dart Sass watcher, so
# SCSS edits recompile automatically instead of needing a manual
# `dartsass:build` after every change.
CMD ["bin/dev"]
